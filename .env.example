# WhatsApp MCP + opencode bridge — copy to .env and fill in.
# NOTE: keep values bare (comments on their own lines). Inline trailing
# comments after a value confuse some dotenv parsers (compose included).

# --- WhatsApp ---
# Comma-separated sender numbers allowed to reach the agent.
WHATSAPP_WHITELIST=6281234567890,6289876543210
# pairing (headless/Docker) | qr (interactive dev only).
WHATSAPP_LOGIN_MODE=pairing
# Required in pairing mode: country-code digits, no + / spaces / trunk 0.
WHATSAPP_PHONE_NUMBER=6281234567890
# Optional extra gate: inbound must contain this keyword to be forwarded.
WHATSAPP_SHARED_SECRET=
# Optional static LID→number map, lid:pn,lid:pn (see README "LID note").
WHATSAPP_LID_MAP=

# --- MCP HTTP (localhost-bound; bearer auth on every call) ---
MCP_BIND=127.0.0.1
MCP_PORT=8787
# Required, min 16 chars. Generate: openssl rand -hex 32
MCP_TOKEN=change-me-to-a-long-random-secret

# --- Bridge behavior ---
# whitelist (only listed senders auto-marked read) | all
AUTO_READ_SCOPE=whitelist
SESSION_TTL_HOURS=6
SESSION_COMPACT_AFTER=40
RATE_LIMIT_PER_SENDER_SECONDS=5

# --- Opencode (serve runs in-container under compose) ---
OPENCODE_HOST=127.0.0.1
OPENCODE_PORT=4096
# Dedicated least-privilege agent, never default/build/plan.
OPENCODE_AGENT=whatsapp-bridge
# Set ONLY together with OPENCODE_SERVER_PASSWORD below (same value).
OPENCODE_PASSWORD=
OPENCODE_TIMEOUT_MS=120000
# Yolo mode (auto-approve; no --yolo flag on serve). Agent denies still win.
OPENCODE_YOLO=true

# --- Model auth (pick ONE: provider key(s) and/or Zen login) ---
# Without any of these, opencode serve starts but has no model to answer with.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional serve password; must mirror into OPENCODE_PASSWORD above.
# OPENCODE_SERVER_PASSWORD=

# --- Storage / runtime (local dev; compose mounts volumes instead) ---
DATA_DIR=./data
DB_PATH=./data/bridge.db
AUTH_DIR=./data/auth_info
# fatal,error,warn,info,debug,trace
LOG_LEVEL=info
TZ=Asia/Jakarta
