{
  "name": "whatsapp-opencode-bridge",
  "version": "0.1.2",
  "description": "Standalone TypeScript daemon: WhatsApp as MCP tools + auto-forward bridge to a least-privilege opencode agent.",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@opencode-ai/sdk": "^1.0.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/qrcode-terminal": "^0.12.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
